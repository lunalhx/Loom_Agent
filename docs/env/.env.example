# === 运行环境 ===
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8091
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=loom-agent

APP_HOST_PORT=8091

# === AI Provider ===
LOOM_AI_PROVIDER=deepseek

# === DeepSeek AI 模型 API ===
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2048

# === OpenCode Go AI 模型 API ===
# 切换到 opencode-go 时设置: LOOM_AI_PROVIDER=opencode-go
OPENCODE_GO_API_KEY=oc-your-api-key-here
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go
OPENCODE_GO_COMPLETIONS_PATH=/v1/chat/completions
OPENCODE_GO_MODEL=deepseek-v4-flash
OPENCODE_GO_TEMPERATURE=0.7
OPENCODE_GO_MAX_TOKENS=2048

# === AI 连接超时 ===
AI_CONNECT_TIMEOUT_MS=10000
AI_FIRST_TOKEN_TIMEOUT_MS=30000
AI_STREAM_TIMEOUT_MS=120000
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_INITIAL_MS=300
AI_RETRY_BACKOFF_MAX_MS=3000
AI_MAX_MESSAGE_LENGTH=20000

# === MCP 工具 ===
MCP_ENABLED=true
MCP_REQUEST_TIMEOUT_MS=60000
MCP_MAX_TOOLS_PER_SERVER=64

EXA_MCP_ENABLED=true
PLAYWRIGHT_MCP_ENABLED=true
PLAYWRIGHT_MCP_TRANSPORT=STDIO
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_PATH=

# === Agent 配置 ===
AGENT_ENABLED=true
AGENT_WORKSPACE_ROOT=.

# ---- 长期记忆（Long Term Memory）----
AGENT_MEMORY_ENABLED=true
# 向量语义检索（需要 sqlite-vec 扩展 + embedding API）
AGENT_MEMORY_VECTOR_ENABLED=true
AGENT_MEMORY_VECTOR_SEARCH_K=50
# embedding 模型配置（阿里百炼 DashScope / 千问 text-embedding-v4）
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_BATCH_SIZE=64
# sqlite-vec 扩展动态库路径（不设置则向量检索降级为关键词搜索）
# SQLITE_VEC_EXTENSION_PATH=

AGENT_MAX_STEPS=30
AGENT_TOTAL_TIMEOUT_MS=1800000
AGENT_STEP_TIMEOUT_MS=120000
AGENT_TOOL_TIMEOUT_MS=3000
AGENT_MODEL_ESCALATED_MAX_TOKENS=8192
AGENT_OBSERVATION_MAX_CHARS=8000
AGENT_PARSE_ERROR_MAX_ATTEMPTS=2
AGENT_FILE_MAX_BYTES=200000
AGENT_SEARCH_MAX_RESULTS=50
HOST_WORKSPACE_ROOT=/path/to/workspace
CONTAINER_WORKSPACE_ROOT=/workspace
CONTAINER_WORKSPACE_ROOTS=/workspace
